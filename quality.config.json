{
  "$comment": "GIGA Standard v4 品質ゲートの設定。scripts/check-project.mjs が読む。",

  "repoName": "Online-Publisher-pro",
  "architecture": "C+",

  "shell": {
    "dir": "pwa",
    "html": "pwa/index.html",
    "manifest": "pwa/manifest.webmanifest",
    "serviceWorker": "pwa/sw.js",
    "offlinePage": "pwa/offline.html"
  },

  "appHtml": ["index.html", "pwa/index.html", "pwa/offline.html"],

  "displayChecks": {
    "requireViewportFitCover": ["index.html", "pwa/index.html", "pwa/offline.html"],
    "requireDvh": ["index.html", "pwa/index.html", "pwa/offline.html"],
    "//見る先": "2026-08-28 に index.html の中身を原本へ移した（JSX は src/app.jsx、その中の GLOBAL_STYLES が画面の CSS）。index.html は差し込みだけの 73 行になったので、CSS を見る検査はそちらを見ない。index.html のままにすると、CSS は配信物にちゃんと入っているのに全部不合格になる（逆に、書いてあるかどうかを何も見ないまま緑になる道もある）",
    "requireSafeArea": ["src/app.jsx", "pwa/index.html", "pwa/offline.html"],
    "requireFluidType": ["src/app.jsx", "pwa/index.html", "pwa/offline.html"],
    "requireReducedMotion": ["src/app.jsx", "pwa/index.html", "pwa/offline.html"],
    "requirePrintCss": ["src/app.jsx"]
  },

  "limits": {
    "maxSourceBytes": 409600,
    "maxSourceLines": 5000,
    "maxImageBytes": 153600,
    "maxIcon512Bytes": 61440,
    "maxFaviconBytes": 30720
  },

  "sourceGlobs": ["index.html", "code.gs", "pwa/index.html", "pwa/sw.js", "pwa/offline.html"],

  "imageDirs": ["pwa", "pwa/icons"],

  "securityExceptions": [
    {
      "id": "docs-note-images-oversize",
      "path": "docs/note/images/",
      "reason": "note 掲載用の紹介記事に貼る画面写真。アプリからは一切読み込まれず、児童の端末には配信されない。圧縮すると記事の可読性が落ちるため、原寸のまま保持する。アプリの初回転送量には含まれない。",
      "approvedBy": "GIGAyama",
      "approvedOn": "2026-08-08"
    }
  ]
}
